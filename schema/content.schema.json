{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "content.schema.json",
  "title": "KBM Prüfungscoach Content-Schema",
  "$defs": {
    "bereichId": {
      "enum": ["wiso", "kbz", "buchfuehrung", "muendlich"]
    },
    "medienSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["titel", "status"],
      "properties": {
        "titel": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "status": { "enum": ["geplant", "vorhanden"] }
      }
    },
    "medien": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "video": { "$ref": "#/$defs/medienSlot" },
        "podcast": { "$ref": "#/$defs/medienSlot" }
      }
    },
    "bereich": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kurz", "beschreibung", "farbe", "hatStufen"],
      "properties": {
        "id": { "$ref": "#/$defs/bereichId" },
        "name": { "type": "string", "minLength": 1 },
        "kurz": { "type": "string", "minLength": 1 },
        "beschreibung": { "type": "string", "minLength": 1 },
        "farbe": { "type": "string", "minLength": 1 },
        "hatStufen": { "type": "boolean" }
      }
    },
    "thema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "bereich", "name", "beschreibung", "haeufigkeit", "lernzettel", "eselsbruecken", "selbstcheck"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "bereich": { "$ref": "#/$defs/bereichId" },
        "name": { "type": "string", "minLength": 1 },
        "beschreibung": { "type": "string", "minLength": 1 },
        "haeufigkeit": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{4}-(sommer|winter)$" } },
        "lernzettel": { "type": "string" },
        "eselsbruecken": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "selbstcheck": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "medien": { "$ref": "#/$defs/medien" }
      }
    },
    "diagrammPunkt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "string", "minLength": 1 },
        "y": { "type": "number" }
      }
    },
    "anlagenDiagramm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["typ", "titel"],
      "properties": {
        "typ": { "enum": ["linie", "balken", "kreis", "organigramm", "schilder", "kreislauf"] },
        "titel": { "type": "string", "minLength": 1 },
        "xAchse": { "type": "string" },
        "yAchse": { "type": "string" },
        "einheit": { "type": "string" },
        "quelle": { "type": "string" },
        "serien": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "punkte"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "punkte": { "type": "array", "items": { "$ref": "#/$defs/diagrammPunkt" }, "minItems": 1 }
            }
          }
        },
        "knoten": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "text": { "type": "string", "minLength": 1 },
              "unter": { "type": "string" },
              "stab": { "type": "boolean" }
            }
          }
        },
        "zeichen": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["nr", "form"],
            "properties": {
              "nr": { "type": "string", "minLength": 1 },
              "form": { "enum": ["kreis", "dreieck", "quadrat", "rechteck", "raute", "sechseck"] },
              "farbe": { "enum": ["gruen", "rot", "gelb", "blau", "grau", "weiss"] },
              "innen": { "type": "string" },
              "text": { "type": "string" }
            }
          }
        },
        "varianten": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "stroeme"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "stroeme": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["text", "richtung"],
                  "properties": {
                    "text": { "type": "string", "minLength": 1 },
                    "richtung": { "enum": ["links", "rechts"] }
                  }
                }
              }
            }
          }
        },
        "linksBox": { "type": "string" },
        "rechtsBox": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "typ": { "enum": ["linie", "balken", "kreis"] } } }, "then": { "required": ["serien"] } },
        { "if": { "properties": { "typ": { "const": "organigramm" } } }, "then": { "required": ["knoten"] } },
        { "if": { "properties": { "typ": { "const": "schilder" } } }, "then": { "required": ["zeichen"] } },
        { "if": { "properties": { "typ": { "const": "kreislauf" } } }, "then": { "required": ["varianten"] } }
      ]
    },
    "aufgabe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "themaId", "bereich", "quelle", "typ", "text", "loesung"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "themaId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "bereich": { "$ref": "#/$defs/bereichId" },
        "quelle": { "enum": ["original", "abgeleitet", "generiert"] },
        "termin": { "type": "string", "pattern": "^[0-9]{4}-(sommer|winter)$" },
        "typ": { "enum": ["mc", "offen", "rechnen"] },
        "text": { "type": "string", "minLength": 1 },
        "anlagenText": { "type": "string" },
        "anlagenDiagramm": { "$ref": "#/$defs/anlagenDiagramm" },
        "punkte": { "type": "number", "minimum": 0 },
        "optionen": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 2 },
        "korrekt": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 1 },
        "loesung": { "type": "string", "minLength": 1 },
        "erklaerung": { "type": "string" }
      },
      "if": { "properties": { "typ": { "const": "mc" } } },
      "then": { "required": ["optionen", "korrekt"] }
    },
    "pruefung": {
      "type": "object",
      "additionalProperties": false,
      "required": ["termin", "bereich", "name", "zeitMinuten", "punkteGesamt", "aufgabenIds"],
      "properties": {
        "termin": { "type": "string", "pattern": "^[0-9]{4}-(sommer|winter)$" },
        "bereich": { "$ref": "#/$defs/bereichId" },
        "name": { "type": "string", "minLength": 1 },
        "zeitMinuten": { "type": "number", "exclusiveMinimum": 0 },
        "punkteGesamt": { "type": "number", "exclusiveMinimum": 0 },
        "aufgabenIds": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "minItems": 1 }
      }
    },
    "karteikarte": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "themaId", "bereich", "vorderseite", "rueckseite"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "themaId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "bereich": { "$ref": "#/$defs/bereichId" },
        "vorderseite": { "type": "string", "minLength": 1 },
        "rueckseite": { "type": "string", "minLength": 1 }
      }
    },
    "lernpaar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "themaId", "bereich", "frage", "optionen", "korrekt", "erklaerung"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "themaId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "bereich": { "$ref": "#/$defs/bereichId" },
        "frage": { "type": "string", "minLength": 1 },
        "optionen": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 2 },
        "korrekt": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 1 },
        "erklaerung": { "type": "string", "minLength": 1 },
        "schwierigkeit": { "enum": [1, 2, 3] },
        "quellTermin": { "type": "string", "pattern": "^[0-9]{4}-(sommer|winter)$" }
      }
    },
    "glossarEintrag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["begriff", "definition", "bereiche"],
      "properties": {
        "begriff": { "type": "string", "minLength": 1 },
        "definition": { "type": "string", "minLength": 1 },
        "bereiche": { "type": "array", "items": { "$ref": "#/$defs/bereichId" }, "minItems": 1 }
      }
    },
    "bereichListe": { "type": "array", "items": { "$ref": "#/$defs/bereich" }, "minItems": 4, "maxItems": 4 },
    "themaListe": { "type": "array", "items": { "$ref": "#/$defs/thema" } },
    "aufgabeListe": { "type": "array", "items": { "$ref": "#/$defs/aufgabe" } },
    "pruefungListe": { "type": "array", "items": { "$ref": "#/$defs/pruefung" } },
    "karteikarteListe": { "type": "array", "items": { "$ref": "#/$defs/karteikarte" } },
    "lernpaarListe": { "type": "array", "items": { "$ref": "#/$defs/lernpaar" } },
    "glossarListe": { "type": "array", "items": { "$ref": "#/$defs/glossarEintrag" } },
    "formelEintrag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "titel", "formel", "bereiche", "kategorie"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "titel": { "type": "string", "minLength": 1 },
        "formel": { "type": "string", "minLength": 1 },
        "erklaerung": { "type": "string" },
        "bereiche": { "type": "array", "items": { "$ref": "#/$defs/bereichId" }, "minItems": 1 },
        "kategorie": { "type": "string", "minLength": 1 }
      }
    },
    "formelListe": { "type": "array", "items": { "$ref": "#/$defs/formelEintrag" }, "minItems": 1 }
  }
}
